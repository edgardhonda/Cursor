<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/forest">

    <com.edgard.labirinto.render.MazeView
        android:id="@+id/maze"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/overlay_menu"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E61A3A24"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="28dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.12"
            android:text="@string/app_name"
            android:textAllCaps="true"
            android:textColor="@color/gold"
            android:textSize="42sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/tagline"
            android:textColor="@color/ink"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btn_play"
            android:layout_width="260dp"
            android:layout_height="64dp"
            android:layout_marginTop="36dp"
            android:background="@drawable/bg_gold"
            android:text="@string/play"
            android:textColor="@color/forest"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="16dp"
        android:gravity="center"
        android:text="@string/choose"
        android:textColor="@color/gold"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/overlay_win"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#D11A3A24"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/escaped"
            android:textColor="@color/gold"
            android:textSize="24sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_again"
            android:layout_width="260dp"
            android:layout_height="56dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_gold"
            android:text="@string/play_again"
            android:textColor="@color/forest"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_new"
            android:layout_width="260dp"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_button"
            android:text="@string/new_map"
            android:textColor="@color/ink" />
    </LinearLayout>
</FrameLayout>
